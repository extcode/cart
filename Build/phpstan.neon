includes:
  - 'phpstan-baseline.neon'

parameters:
  todo_by:
    # The version being developed, checked by version TODOs like
    # "TODO: 13.0.0 Remove ...". Bump it in the prepare-release PR and set the
    # next major as soon as the work on it starts.
    referenceVersion: '12.9.0'

  level: 'max'

  paths:
    - ../Classes
    - ../Configuration
    - ../Tests
    - ../ext_localconf.php

  excludePaths:
    - ../Tests/Acceptance/Support/_generated

  disallowedFunctionCalls:
    -
      function:
        - 'var_dump()'
        - 'xdebug_break()'
      message: 'Do not add debugging'
    -
      function: 'header()'
      message: 'Use API instead'

  disallowedStaticCalls:
      -
        method: 'TYPO3\CMS\Extbase\Utility\DebuggerUtility::var_dump()'
        message: 'Do not add debugging'

  disallowedSuperglobals:
      -
        superglobal:
          - '$_GET'
          - '$_POST'
          - '$_FILES'
          - '$_SERVER'
        message: 'Use API instead'

  ignoreErrors:
    # The deprecated MailHandler is still used without the feature toggle cart.useNewOrderMailSender.
    # TODO: 13.0.0 Remove with the MailHandler, see Deprecation #845.
    -
      identifiers:
        - 'method.deprecatedClass'
        - 'parameter.deprecatedClass'
      path: '../Classes/EventListener/Order/Finish/Email.php'
    -
      identifiers:
        - 'classConstant.deprecatedClass'
        - 'method.deprecatedClass'
        - 'return.deprecatedClass'
      path: '../Tests/Functional/Service/MailHandlerTest.php'
    -
      identifiers:
        - 'classConstant.deprecatedClass'
        - 'parameter.deprecatedClass'
      path: '../Tests/Unit/EventListener/Order/Finish/EmailTest.php'
    # The deprecated IncludeFileViewHelper is still tested.
    # TODO: 13.0.0 Remove with the IncludeFileViewHelper, see Deprecation #869.
    -
      identifier: 'classConstant.deprecatedClass'
      path: '../Tests/Functional/ViewHelpers/IncludeFileViewHelperTest.php'
